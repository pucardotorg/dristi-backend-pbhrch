# =============================================================================
# dristi-monolith — local environment variables
# Copy this file to .env and fill in the values marked REQUIRED.
# Variables with a default comment can be left blank to use that default.
# =============================================================================

# ── Application image ─────────────────────────────────────────────────────
# Pre-built image tag. To build locally, leave this blank and uncomment the
# `build:` block in docker-compose.yml.
DRISTI_IMAGE=dristi-monolith:latest

# ── JVM / App port ────────────────────────────────────────────────────────
APP_PORT=8080
JAVA_OPTS=-Xms512m -Xmx1g

# ── PostgreSQL ────────────────────────────────────────────────────────────
DB_NAME=dristi
DB_USER=postgres
DB_PASSWORD=postgres          # CHANGE in non-local environments
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── Redpanda ──────────────────────────────────────────────────────────────
REDPANDA_VERSION=v24.1.1
REDPANDA_CONSOLE_VERSION=v2.5.2
REDPANDA_CONSOLE_PORT=8089

# ── eGov platform service hosts ───────────────────────────────────────────
# Point these at your running DIGIT stack (dev/qa env or local stubs).

# REQUIRED — user service
EGOV_USER_HOST=http://your-digit-host

# REQUIRED — MDMS
EGOV_MDMS_HOST=http://your-digit-host

# REQUIRED — ID generation
EGOV_IDGEN_HOST=http://your-digit-host

# REQUIRED — Individual service
EGOV_INDIVIDUAL_HOST=http://your-digit-host

# REQUIRED — File store
EGOV_FILESTORE_HOST=http://your-digit-host

# REQUIRED — Workflow engine
EGOV_WORKFLOW_HOST=http://your-digit-host

# REQUIRED — HRMS
EGOV_HRMS_HOST=http://your-digit-host

# REQUIRED — URL shortener
EGOV_URL_SHORTNER_HOST=http://your-digit-host

# REQUIRED — Encryption service
EGOV_ENC_HOST=http://your-digit-host

# REQUIRED — Billing service
EGOV_BILLING_HOST=http://your-digit-host

# ── Paths (defaults are fine unless your deployment differs) ──────────────
EGOV_USER_CONTEXT_PATH=/user/users
EGOV_USER_CREATE_PATH=/_createnovalidate
EGOV_USER_SEARCH_PATH=/user/v1/_search
EGOV_USER_UPDATE_PATH=/_updatenovalidate
EGOV_MDMS_SEARCH_ENDPOINT=/egov-mdms-service/v1/_search
EGOV_MDMS_V2_SEARCH_ENDPOINT=/egov-mdms-service/v2/_search
EGOV_IDGEN_PATH=/egov-idgen/id/_generate
EGOV_INDIVIDUAL_SEARCH_PATH=individual/v1/_search
EGOV_FILESTORE_PATH=/filestore/v1/files
EGOV_WORKFLOW_TRANSITION_PATH=/egov-workflow-v2/egov-wf/process/_transition
EGOV_WORKFLOW_BUSINESSSERVICE_SEARCH_PATH=/egov-workflow-v2/egov-wf/businessservice/_search
EGOV_HRMS_SEARCH_ENDPOINT=/egov-hrms/employees/_search
EGOV_URL_SHORTNER_ENDPOINT=/egov-url-shortening/shortener
EGOV_ENC_ENCRYPT_ENDPOINT=/egov-enc-service/crypto/v1/_encrypt
EGOV_ENC_DECRYPT_ENDPOINT=/egov-enc-service/crypto/v1/_decrypt
EGOV_DEMAND_CREATE_ENDPOINT=/billing-service/demand/_create

# ── State / tenant ────────────────────────────────────────────────────────
STATE_LEVEL_TENANT_ID=pb
EGOV_COURT_ID=KLKM52

# ── Lock service ──────────────────────────────────────────────────────────
PUCAR_LOCK_DURATION=1200000

# ── Logging ───────────────────────────────────────────────────────────────
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_ORG_PUCAR=DEBUG
